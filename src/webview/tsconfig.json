{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "paths": {
      "shiki/langs/*": [
        "../../node_modules/shiki/dist/langs/*.d.mts"
      ],
      "shiki/themes/*": [
        "../../node_modules/shiki/dist/themes/*.d.mts"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ]
}
